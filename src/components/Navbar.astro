---
import { NAV, SITE } from '../data/site';
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 flex items-center justify-between px-8 py-5 border-b"
        style="background: var(--bg-page); border-color: var(--border); backdrop-filter: blur(12px);">

  <a href="/" class="flex items-center gap-2 text-xs font-medium tracking-widest uppercase"
     style="color: var(--text-primary)" aria-label={SITE.name}>
    <!-- Titik merah logo -->
    <span class="w-2 h-2 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
    {SITE.name}
  </a>

  <nav aria-label="Navigasi utama">
    <ul class="flex gap-7 list-none" role="list">
      {NAV.map(({ label, href }) => {
        const isActive = href === '/' ? currentPath === '/' : currentPath.startsWith(href);
        return (
          <li>
            <a
              href={href}
              class:list={[
                'text-xs tracking-wide pb-0.5 border-b transition-colors duration-200',
                isActive
                  ? 'border-accent'
                  : 'border-transparent hover:border-transparent'
              ]}
              style={isActive
                ? 'color: var(--text-primary)'
                : 'color: var(--text-hint)'}
              aria-current={isActive ? 'page' : undefined}
            >
              {label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Theme toggle -->
  <button
    id="theme-toggle"
    class="flex items-center justify-center w-8 h-8 border text-base transition-colors duration-200"
    style="border-color: var(--border); color: var(--text-hint);"
    aria-label="Toggle tema gelap/terang"
  >
    <!-- Hanya satu icon yang visible, dikontrol CSS via [data-theme] di <html> -->
    <i class="ti ti-sun" id="icon-sun" aria-hidden="true"></i>
    <i class="ti ti-moon" id="icon-moon" aria-hidden="true"></i>
  </button>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    localStorage.setItem('bmj-theme', next);
  });
</script>
