---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE, FACILITIES, TIMELINE, SOCIALS, cdnUrl } from '../data/site';
---

<BaseLayout
  title="Tentang Kami"
  description={`Sejarah dan fasilitas ${SITE.fullName}. Berdiri sejak 2002, destinasi wisata unggulan Mojokerto dengan Patung Gajah Mada pemegang Rekor MURI.`}
>
  <Navbar />

  <!-- TAGLINE HERO -->
  <section class="ab-hero">
    <blockquote class="ab-tagline">
      "Wisataku,<br />Wisatamu,<br /><em>Wisatane Wong Akeh."</em>
    </blockquote>
    <div class="ab-hero-right">
      <p class="eyebrow">Tentang Kami</p>
      <p class="ab-hero-body">
        Wisata Desa BMJ Mojopahit adalah destinasi wisata unggulan Jawa Timur yang
        menjaga warisan budaya Majapahit sambil menghadirkan pengalaman liburan yang
        berkesan untuk semua kalangan.
      </p>
    </div>
  </section>

  <!-- FOTO + INTRO -->
  <div class="ab-intro">
    <img
      src={cdnUrl('fzqopymhl6fkx0hnzjna', 1200, 700)}
      alt="Pemandangan utama Wisata Desa BMJ Mojopahit"
      class="ab-intro-img"
      loading="lazy"
      width="1200" height="700"
    />
    <div class="ab-intro-text">
      <p class="eyebrow">Sejarah Singkat</p>
      <h1 class="ab-intro-heading">BERDIRI SEJAK {SITE.founded}</h1>
      <p class="ab-intro-body">
        Didirikan oleh Mulyono di Desa Randugenengan, Kecamatan Dlanggu, Kabupaten Mojokerto.
        BMJ mengusung elemen-elemen Kerajaan Majapahit, termasuk ikon utamanya: Patung
        Mahapatih Gajah Mada setinggi {SITE.patungHeight} meter — pemegang Rekor MURI
        sebagai patung Gajah Mada terbesar dan tertinggi di Indonesia.
      </p>
      <!-- Statistik singkat membantu SEO dengan angka konkret -->
      <dl class="ab-stats">
        <div class="ab-stat">
          <dt class="stat-label">Tahun Beroperasi</dt>
          <dd class="stat-num">21+</dd>
        </div>
        <div class="ab-stat">
          <dt class="stat-label">Tinggi Patung MURI</dt>
          <dd class="stat-num">{SITE.patungHeight}m</dd>
        </div>
        <div class="ab-stat">
          <dt class="stat-label">Fasilitas Utama</dt>
          <dd class="stat-num">8+</dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- TIMELINE -->
  <section class="ab-timeline-section" aria-labelledby="timeline-title">
    <div class="section-header">
      <h2 id="timeline-title" class="section-title">PERJALANAN KAMI</h2>
      <div class="section-line" aria-hidden="true"></div>
    </div>

    <!--
      Timeline dibagi 2 baris (slice) supaya tidak terlalu panjang horizontal.
      Kalau menambah item di TIMELINE data, grid otomatis menyesuaikan.
    -->
    <ol class="ab-timeline" role="list">
      {TIMELINE.map(({ year, title, desc }) => (
        <li class="ab-tl-item">
          <p class="ab-tl-year" aria-hidden="true">{year}</p>
          <div class="ab-tl-dot" aria-hidden="true"></div>
          <h3 class="ab-tl-title">{title}</h3>
          <p class="ab-tl-desc">{desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- FASILITAS -->
  <section class="ab-facility-section" aria-labelledby="facility-title">
    <div class="section-header">
      <h2 id="facility-title" class="section-title">FASILITAS KAMI</h2>
      <div class="section-line" aria-hidden="true"></div>
    </div>

    <ul class="ab-facility-grid" role="list">
      {FACILITIES.map(({ name, note, icon }) => (
        <li class="ab-facility">
          <!-- icon dari Tabler Icons, nama icon disimpan di data/site.ts -->
          <i class={`ti ti-${icon} ab-fac-icon`} aria-hidden="true"></i>
          <div>
            <p class="ab-fac-name">{name}</p>
            <p class="ab-fac-note">{note}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- SOSIAL MEDIA -->
  <section class="ab-social-section" aria-labelledby="social-title">
    <div>
      <h2 id="social-title" class="ab-social-title">IKUTI KAMI</h2>
      <p class="ab-social-sub">Lihat aktivitas terbaru kami di media sosial</p>
    </div>
    <div class="ab-social-links">
      {SOCIALS.map(({ label, icon, url }) => (
        <a href={url} target="_blank" rel="noopener noreferrer" class="ab-social-btn">
          <i class={`ti ti-${icon}`} aria-hidden="true"></i>
          {label}
        </a>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
.eyebrow { font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }

/* HERO */
.ab-hero { padding: 72px 32px 56px; border-bottom: 0.5px solid var(--border); display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; }
.ab-tagline { font-family: var(--font-serif); font-style: italic; font-size: 52px; font-weight: 300; line-height: 1.1; color: var(--text-primary); max-width: 520px; border: none; }
.ab-tagline em { font-style: normal; color: var(--accent); }
.ab-hero-right { max-width: 240px; }
.ab-hero-body { font-size: 13px; line-height: 1.9; color: var(--text-muted); }

/* INTRO */
.ab-intro { display: grid; grid-template-columns: 1fr 1fr; min-height: 360px; }
.ab-intro-img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.72); }
.ab-intro-text { background: var(--bg-surface); padding: 48px 40px; display: flex; flex-direction: column; justify-content: center; gap: 18px; }
.ab-intro-heading { font-family: var(--font-display); font-size: 44px; letter-spacing: 2px; line-height: 1; color: var(--text-primary); }
.ab-intro-body { font-size: 13px; line-height: 2; color: var(--text-muted); }
.ab-stats { display: flex; gap: 28px; margin-top: 4px; }
.ab-stat { display: flex; flex-direction: column; }
.stat-num { font-family: var(--font-display); font-size: 36px; color: var(--text-primary); letter-spacing: 1px; }
.stat-label { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-hint); margin-bottom: 2px; }

/* TIMELINE */
.ab-timeline-section { padding: 64px 32px; }
.section-header { display: flex; align-items: baseline; gap: 20px; margin-bottom: 48px; }
.section-title { font-family: var(--font-display); font-size: 38px; letter-spacing: 2px; color: var(--text-primary); white-space: nowrap; }
.section-line { flex: 1; height: 0.5px; background: var(--border); }
.ab-timeline { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; list-style: none; }
.ab-tl-item { padding: 0 24px 0 0; position: relative; }
/* Garis vertikal pemisah antar item — hanya antar kolom, bukan kolom terakhir */
.ab-tl-item:not(:nth-child(4n))::after { content: ''; position: absolute; top: 8px; right: 0; width: 1px; height: 80%; background: var(--border); }
.ab-tl-year { font-family: var(--font-display); font-size: 40px; color: var(--text-decor); line-height: 1; margin-bottom: 8px; transition: color .3s; }
.ab-tl-item:hover .ab-tl-year { color: var(--accent); }
.ab-tl-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--border); margin-bottom: 10px; transition: background .3s; }
.ab-tl-item:hover .ab-tl-dot { background: var(--accent); }
.ab-tl-title { font-size: 13px; font-weight: 500; color: var(--text-primary); margin-bottom: 6px; line-height: 1.4; }
.ab-tl-desc { font-size: 11px; line-height: 1.8; color: var(--text-hint); }

/* FASILITAS */
.ab-facility-section { background: var(--bg-surface); padding: 56px 32px; }
.ab-facility-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--bg-gap); list-style: none; }
.ab-facility { background: var(--bg-surface); padding: 24px 20px; display: flex; align-items: flex-start; gap: 14px; transition: background .2s; }
.ab-facility:hover { background: var(--bg-hover); }
.ab-fac-icon { font-size: 20px; color: var(--accent); flex-shrink: 0; margin-top: 2px; }
.ab-fac-name { font-size: 13px; font-weight: 500; color: var(--text-primary); line-height: 1.4; }
.ab-fac-note { font-size: 11px; color: var(--text-hint); margin-top: 2px; }

/* SOSIAL */
.ab-social-section { padding: 56px 32px; display: flex; align-items: center; justify-content: space-between; gap: 32px; border-top: 0.5px solid var(--border); }
.ab-social-title { font-family: var(--font-display); font-size: 36px; letter-spacing: 2px; color: var(--text-primary); margin-bottom: 6px; }
.ab-social-sub { font-size: 12px; color: var(--text-hint); }
.ab-social-links { display: flex; gap: 10px; }
.ab-social-btn { display: flex; align-items: center; gap: 8px; padding: 10px 20px; border: 0.5px solid var(--border); font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-hint); transition: all .2s; }
.ab-social-btn:hover { border-color: var(--accent); color: var(--text-primary); }
</style>
