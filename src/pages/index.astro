---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { SITE, PHOTOS, TICKETS, formatPrice, cdnUrl } from '../data/site';

const featuredPhoto = PHOTOS.find(p => p.featured)!;
const cardPhotos = PHOTOS.filter(p => !p.featured).slice(0, 3);
const rankLabels = ['1st place', '2nd place', '3rd place', '4th place'];
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Navbar />

  <!-- HERO -->
  <section class="hero" aria-label="Hero utama">
    <img
      src={cdnUrl('fzqopymhl6fkx0hnzjna', 1920, 900)}
      alt="Wisata Desa BMJ Mojopahit"
      class="hero-img"
      fetchpriority="high"
      loading="eager"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <ol class="hero-nums" aria-hidden="true">
      {['03','04','05','06','07'].map((n, i) => (
        <li class:list={['num', { curr: i === 2 }]}>{n}</li>
      ))}
    </ol>
    <div class="hero-content">
      <h1 class="hero-title">
        <span>WISATA</span>
        <span>DESA BMJ</span>
      </h1>
      <div class="hero-subs">
        <div class="hero-sub">
          <strong>Patung Gajah Mada</strong>
          Patung Mahapatih Gajah Mada setinggi 23 meter, pemegang Rekor MURI sebagai patung Gajah Mada terbesar dan tertinggi di Indonesia.
        </div>
        <div class="hero-sub">
          <strong>Warisan Majapahit</strong>
          Mengusung elemen-elemen budaya Kerajaan Majapahit. Terletak di Randugenengan, Dlanggu, Mojokerto.
        </div>
        <div class="hero-sub">
          <strong>21 Tahun Melayani</strong>
          Destinasi unggulan Jawa Timur yang telah menyambut wisatawan lokal maupun mancanegara.
        </div>
      </div>
      <a href="/galeri" class="swipe-cta" aria-label="Lihat galeri foto">
        <span class="swipe-line" aria-hidden="true"></span>
        Jelajahi →
      </a>
    </div>
  </section>

  <!-- DESTINASI UNGGULAN -->
  <section class="rec-section" aria-labelledby="rec-title">
    <div class="rec-header">
      <p class="eyebrow">Bingung mau ke mana? Ini rekomendasinya</p>
      <h2 id="rec-title" class="rec-title">Destinasi Unggulan di BMJ</h2>
    </div>
    <ul class="cards" role="list">
      {[featuredPhoto, ...cardPhotos].map((photo, i) => (
        <li class="card">
          <a href="/galeri" aria-label={`Lihat foto ${photo.name}`}>
            <img
              src={cdnUrl(photo.id, 600, 400)}
              alt={photo.name}
              loading={i === 0 ? 'eager' : 'lazy'}
              width="600" height="400"
            />
            <div class="card-label">
              <p class="card-rank">{rankLabels[i]}</p>
              <p class="card-name">{photo.name}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- CTA -->
  <section class="cta-section" aria-label="Ajakan liburan">
    <img src={cdnUrl('hzxhtstlm1i6g2nzp4pv', 1920, 800)} alt="Suasana Wisata Desa BMJ" class="cta-img" loading="lazy" />
    <div class="cta-overlay" aria-hidden="true"></div>
    <div class="cta-content">
      <h2 class="cta-title">NIKMATI LIBURANMU BERSAMA KAMI</h2>
      <div class="cta-right">
        <p class="cta-desc">Wisata Desa BMJ Mojopahit hadir untuk keluarga, komunitas, dan wisatawan yang ingin merasakan budaya dan alam Jawa Timur yang autentik.</p>
        <a href="/about" class="btn-primary">Tentang Kami →</a>
      </div>
    </div>
  </section>

  <!-- TIKET -->
  <section class="tickets-section" aria-labelledby="tickets-title">
    <div class="tickets-header">
      <h2 id="tickets-title" class="tickets-title">DAFTAR TIKET MASUK</h2>
      <span class="tickets-sub">Mojokerto, Jawa Timur</span>
    </div>
    <ul class="ticket-grid" role="list">
      {TICKETS.map(({ type, name, price, note }) => (
        <li class="ticket">
          <p class="ticket-type">{type}</p>
          <p class="ticket-name">{name}</p>
          <p class="ticket-price">{formatPrice(price)}</p>
          <p class="ticket-note">{note}</p>
        </li>
      ))}
    </ul>
  </section>

  <Footer />
</BaseLayout>

<style>
.hero { position: relative; height: 560px; overflow: hidden; }
.hero-img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.5); }
.hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(0,0,0,0.55) 40%, transparent); }
.hero-nums { position: absolute; right: 32px; top: 50%; transform: translateY(-50%); list-style: none; display: flex; flex-direction: column; align-items: center; gap: 6px; }
.num { font-size: 11px; color: rgba(240,236,228,0.25); letter-spacing: 1px; }
.num.curr { font-size: 18px; font-weight: 500; color: #f0ece4; }
.hero-content { position: absolute; bottom: 52px; left: 32px; right: 80px; }
.hero-title { font-family: var(--font-display); font-size: 108px; line-height: .88; letter-spacing: 2px; color: #fff; }
.hero-title span { display: block; }
.hero-subs { display: flex; gap: 32px; margin-top: 28px; max-width: 680px; }
.hero-sub { flex: 1; font-size: 11px; line-height: 1.8; color: rgba(240,236,228,0.7); }
.hero-sub strong { display: block; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--accent); margin-bottom: 4px; }
.swipe-cta { display: inline-flex; align-items: center; gap: 10px; margin-top: 20px; font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: rgba(240,236,228,0.45); transition: color .2s; }
.swipe-cta:hover { color: rgba(240,236,228,0.85); }
.swipe-line { display: inline-block; width: 40px; height: 1px; background: var(--accent); }

.rec-section { background: var(--bg-surface); padding: 56px 32px; }
.rec-header { text-align: center; margin-bottom: 36px; }
.eyebrow { font-size: 11px; letter-spacing: 3px; text-transform: uppercase; color: var(--text-hint); margin-bottom: 8px; }
.rec-title { font-family: var(--font-serif); font-style: italic; font-size: 30px; font-weight: 300; color: var(--text-primary); }
.cards { display: grid; grid-template-columns: repeat(4,1fr); gap: 2px; list-style: none; }
.card { position: relative; overflow: hidden; }
.card a { display: block; }
.card img { width: 100%; height: 220px; object-fit: cover; filter: brightness(0.7); transition: filter .3s, transform .4s; }
.card:hover img { filter: brightness(.92); transform: scale(1.04); }
.card-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 32px 16px 14px; background: linear-gradient(to top, rgba(0,0,0,0.82), transparent); }
.card-rank { font-size: 9px; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); margin-bottom: 3px; }
.card-name { font-size: 13px; font-weight: 500; color: #fff; }

.cta-section { position: relative; height: 400px; overflow: hidden; }
.cta-img { width: 100%; height: 100%; object-fit: cover; filter: brightness(0.38); }
.cta-overlay { position: absolute; inset: 0; background: rgba(10,10,10,0.45); }
.cta-content { position: absolute; bottom: 52px; left: 32px; right: 32px; display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; }
.cta-title { font-family: var(--font-display); font-size: 68px; line-height: .9; color: #fff; max-width: 460px; }
.cta-right { display: flex; flex-direction: column; align-items: flex-end; gap: 16px; }
.cta-desc { font-size: 12px; line-height: 1.8; color: rgba(240,236,228,0.6); max-width: 250px; text-align: right; }
.btn-primary { display: inline-block; background: var(--accent); color: #fff; font-size: 11px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; padding: 12px 24px; transition: background .2s; }
.btn-primary:hover { background: var(--accent-hover); }

.tickets-section { background: var(--bg-ticket); padding: 56px 32px; }
.tickets-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 28px; }
.tickets-title { font-family: var(--font-display); font-size: 40px; letter-spacing: 2px; color: var(--text-primary); }
.tickets-sub { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-hint); }
.ticket-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--bg-gap); list-style: none; }
.ticket { background: var(--bg-ticket); padding: 28px 24px; border-top: 2px solid transparent; transition: border-color .2s; }
.ticket:hover { border-top-color: var(--accent); }
.ticket-type { font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--text-hint); margin-bottom: 10px; }
.ticket-name { font-size: 16px; font-weight: 500; color: var(--text-primary); margin-bottom: 8px; }
.ticket-price { font-family: var(--font-display); font-size: 40px; color: var(--accent); letter-spacing: 1px; }
.ticket-note { font-size: 11px; color: var(--text-hint); margin-top: 4px; }
</style>
