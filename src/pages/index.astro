---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PHOTOS, TICKETS, formatPrice, cdnUrl, NAV } from '../data/site';
import Ticket from '../components/Ticket.astro';

const featuredPhoto = PHOTOS.find(p => p.featured)!;
const cardPhotos    = PHOTOS.filter(p => !p.featured).slice(0, 3);
const rankLabels    = ['Unggulan', 'Pilihan 2', 'Pilihan 3', 'Pilihan 4'];
---

<BaseLayout title={SITE.name} description={SITE.description}>

  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden" style="min-height: min(70vh, 600px);" aria-label="Selamat datang di Wisata Desa BMJ">

    <!-- Video background dengan fallback -->
    <video
      autoplay
      loop
      muted
      playsinline
      class="absolute inset-0 w-full h-full object-cover opacity-50"
      aria-hidden="true"
    >
      <source src="https://res.cloudinary.com/dlw8ltf9c/video/upload/v1762758103/Homepage_video_1_ordr24.mp4" type="video/mp4" />
    </video>

    <!-- Overlay gradient -->
    <div class="absolute inset-0"
         style="background: linear-gradient(to right, rgba(0,0,0,0.65) 40%, rgba(0,0,0,0.2))"
         aria-hidden="true"></div>

    <!-- Nomor dekoratif — tersembunyi dari screen reader -->
    <ol class="absolute right-4 sm:right-8 top-1/2 -translate-y-1/2 flex flex-col items-center gap-1.5 list-none hidden sm:flex"
        aria-hidden="true">
      {['03','04','05','06','07'].map((n, i) => (
        <li class:list={[
          'tracking-wide',
          i === 2 ? 'text-lg font-medium text-white' : 'text-[11px] text-white/25'
        ]}>{n}</li>
      ))}
    </ol>

    <!-- Konten hero -->
    <div class="relative flex flex-col justify-end h-full px-4 sm:px-8 pb-10 sm:pb-12 pt-20 sm:pt-24"
         style="min-height: min(70vh, 600px);">

      <!-- Judul besar menggunakan clamp untuk responsif -->
      <h1 class="hero-headline font-display text-white leading-[.88] tracking-[2px]" aria-label="Wisata Desa BMJ">
        <span class="block">WISATA</span>
        <span class="block">DESA BMJ</span>
      </h1>

      <!-- Tiga fitur unggulan — teks lebih besar untuk keterbacaan lansia -->
      <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 mt-6 sm:mt-7 max-w-2xl">
        {[
          { label: 'Patung Gajah Mada',  body: 'Patung Mahapatih Gajah Mada setinggi 23 meter, pemegang Rekor MURI sebagai patung Gajah Mada terbesar dan tertinggi di Indonesia.' },
          { label: 'Warisan Majapahit',   body: 'Mengusung elemen-elemen budaya Kerajaan Majapahit. Terletak di Randugenengan, Dlanggu, Mojokerto.' },
          { label: '21 Tahun Melayani',  body: 'Destinasi unggulan Jawa Timur yang telah menyambut wisatawan lokal maupun mancanegara.' },
        ].map(({ label, body }) => (
          <div class="flex-1 text-sm sm:text-[13px] leading-relaxed text-white/80">
            <strong class="block text-xs tracking-[2px] uppercase text-accent mb-1.5">{label}</strong>
            {body}
          </div>
        ))}
      </div>

      <!-- CTA link -->
      <a href="/galeri"
         class="inline-flex items-center gap-2.5 mt-6 text-sm tracking-[2px] uppercase text-white/50 hover:text-white/90 transition-colors duration-200 min-h-[44px]"
         aria-label="Jelajahi galeri foto Wisata Desa BMJ">
        <span class="inline-block w-8 h-px bg-accent" aria-hidden="true"></span>
        Jelajahi Galeri →
      </a>
    </div>
  </section>

  <!-- ===== DESTINASI UNGGULAN ===== -->
  <section class="py-12 sm:py-14 px-4 sm:px-8"
           style="background: var(--bg-surface);"
           aria-labelledby="rec-title">

    <div class="text-center mb-8 sm:mb-9">
      <p class="text-xs tracking-[3px] uppercase mb-3" style="color: var(--text-hint);">
        Bingung mau ke mana? Ini rekomendasinya
      </p>
      <h2 id="rec-title" class="font-serif italic text-2xl sm:text-[30px] font-light" style="color: var(--text-primary);">
        Destinasi Unggulan di BMJ
      </h2>
    </div>

    <!-- Grid foto: 4 kolom desktop, 2 di tablet, 1 di mobile -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-2 sm:gap-0.5 list-none grid-photos-4"
        aria-label="Destinasi unggulan Wisata Desa BMJ">

      {[featuredPhoto, ...cardPhotos].map((photo, i) => (
        <li class="relative overflow-hidden group rounded-sm sm:rounded-none">
          <a href="/galeri"
             class="block"
             aria-label={`Lihat galeri foto ${photo.name} — ${rankLabels[i]}`}>

            <img src={cdnUrl(photo.id, 600, 400)}
                 alt={`${photo.name} — salah satu destinasi unggulan Wisata Desa BMJ`}
                 class="w-full object-cover brightness-[0.7] group-hover:brightness-[0.92] group-hover:scale-[1.04] transition-all duration-400"
                 style="height: clamp(180px, 30vw, 220px);"
                 loading={i === 0 ? 'eager' : 'lazy'}
                 width="600" height="400" />

            <div class="absolute bottom-0 left-0 right-0 px-4 pt-8 pb-4 photo-gradient">
              <p class="text-[10px] tracking-[3px] uppercase text-accent mb-1" aria-hidden="true">
                {rankLabels[i]}
              </p>
              <p class="text-sm sm:text-base font-medium text-white">{photo.name}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ===== CTA ===== -->
  <section class="relative overflow-hidden"
           style="min-height: clamp(280px, 40vw, 400px);"
           aria-label="Undangan liburan bersama Wisata Desa BMJ">

    <img src={cdnUrl('hzxhtstlm1i6g2nzp4pv', 1920, 800)}
         alt="Suasana Wisata Desa BMJ — keluarga menikmati liburan di area taman"
         class="absolute inset-0 w-full h-full object-cover brightness-[0.38]"
         loading="lazy" />

    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>

    <div class="relative flex flex-col lg:flex-row items-start lg:items-end justify-between gap-6 lg:gap-8 px-4 sm:px-8 pb-10 sm:pb-12 pt-20 sm:pt-24 h-full"
         style="min-height: clamp(280px, 40vw, 400px);">

      <h2 class="cta-headline font-display text-white leading-[.92] max-w-xl">
        NIKMATI LIBURANMU BERSAMA KAMI
      </h2>

      <div class="flex flex-col items-start lg:items-end gap-4 max-w-xs lg:max-w-xs">
        <p class="text-sm leading-relaxed lg:text-right" style="color: rgba(240,236,228,0.7);">
          Wisata Desa BMJ Mojopahit hadir untuk keluarga, komunitas, dan wisatawan yang
          ingin merasakan budaya dan alam Jawa Timur yang autentik.
        </p>
        <a href={NAV[1].href}
           class="btn-primary"
           aria-label="Pelajari lebih lanjut tentang Wisata Desa BMJ">
          Tentang Kami →
        </a>
      </div>
    </div>
  </section>

  <!-- ===== TIKET ===== -->
  <Ticket />

</BaseLayout>
