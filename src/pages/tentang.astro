---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, FACILITIES, TIMELINE, SOCIALS, cdnUrl } from '../data/site';
---

<BaseLayout
  title="Tentang Kami"
  description={`Sejarah dan fasilitas ${SITE.fullName}. Berdiri sejak 2002, destinasi wisata unggulan Mojokerto dengan Patung Gajah Mada pemegang Rekor MURI.`}
>

  <!-- TAGLINE HERO -->
  <section class="flex flex-col lg:flex-row items-start lg:items-end justify-between gap-8 px-4 sm:px-8 pt-12 sm:pt-18 pb-10 sm:pb-14 border-b"
           style="border-color: var(--border);"
           aria-labelledby="about-tagline">

    <blockquote class="font-serif italic leading-[1.15] max-w-xl border-none"
                style="font-size: clamp(1.75rem, 6vw, 3.25rem); color: var(--text-primary);"
                id="about-tagline">
      <cite class="not-italic">"Wisataku,<br />Wisatamu,<br /><em class="not-italic text-accent">Wisatane Wong Akeh."</em></cite>
    </blockquote>

    <div class="max-w-sm">
      <p class="text-xs tracking-[3px] uppercase text-accent mb-3">Tentang Kami</p>
      <p class="text-base leading-relaxed" style="color: var(--text-muted);">
        Wisata Desa BMJ Mojopahit adalah destinasi wisata unggulan Jawa Timur yang
        menjaga warisan budaya Majapahit sambil menghadirkan pengalaman liburan yang
        berkesan untuk semua kalangan.
      </p>
    </div>
  </section>

  <!-- FOTO + INTRO -->
  <div class="grid grid-cols-1 md:grid-cols-2 min-h-80">

    <figure class="m-0">
      <img src={cdnUrl('fzqopymhl6fkx0hnzjna', 1200, 700)}
           alt="Pemandangan utama Wisata Desa BMJ Mojopahit — area taman dengan nuansa budaya Majapahit"
           class="w-full object-cover brightness-[0.72]"
           style="height: clamp(250px, 40vw, 500px);"
           loading="lazy" width="1200" height="700" />
    </figure>

    <div class="flex flex-col justify-center gap-5 px-6 sm:px-10 py-10 sm:py-12"
         style="background: var(--bg-surface);">

      <p class="text-xs tracking-[3px] uppercase text-accent">Sejarah Singkat</p>

      <h1 class="font-display tracking-[2px] leading-none section-headline"
          style="color: var(--text-primary); font-size: clamp(2rem, 5vw, 2.75rem);">
        BERDIRI SEJAK {SITE.founded}
      </h1>

      <p class="text-base leading-loose" style="color: var(--text-muted);">
        Didirikan oleh Mulyono di Desa Randugenengan, Kecamatan Dlanggu, Kabupaten Mojokerto.
        BMJ mengusung elemen-elemen Kerajaan Majapahit, termasuk ikon utamanya: Patung
        Mahapatih Gajah Mada setinggi {SITE.patungHeight} meter — pemegang Rekor MURI
        sebagai patung Gajah Mada terbesar dan tertinggi di Indonesia.
      </p>

      <!-- Statistik singkat -->
      <dl class="flex flex-wrap gap-5 sm:gap-7 mt-1"
          aria-label="Statistik Wisata Desa BMJ">
        {[
          { label: 'Tahun Beroperasi',   value: '21+' },
          { label: 'Tinggi Patung MURI', value: `${SITE.patungHeight}m` },
          { label: 'Fasilitas Utama',    value: '8+' },
        ].map(({ label, value }) => (
          <div class="flex flex-col">
            <dt class="text-xs tracking-[2px] uppercase mb-1" style="color: var(--text-hint);">{label}</dt>
            <dd class="font-display text-4xl tracking-wide leading-none" style="color: var(--text-primary);">
              {value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>

  <!-- TIMELINE -->
  <section class="px-4 sm:px-8 py-12 sm:py-16" aria-labelledby="timeline-title">

    <div class="flex items-baseline gap-5 mb-10 sm:mb-12">
      <h2 id="timeline-title"
          class="font-display tracking-[2px] whitespace-nowrap section-headline"
          style="color: var(--text-primary);">
        PERJALANAN KAMI
      </h2>
      <div class="flex-1 h-px" style="background: var(--border);" aria-hidden="true"></div>
    </div>

    <!-- Grid timeline: 4 kolom desktop, 2 di tablet/mobile -->
    <ol class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 list-none grid-timeline-4"
        aria-label="Perjalanan sejarah Wisata Desa BMJ dari tahun 2002 hingga sekarang">

      {TIMELINE.map(({ year, title, desc }) => (
        <li class="group p-4 sm:m-4 border border-transparent hover:border-accent/20 transition-colors duration-300 rounded-sm">
          <!-- Tahun: besar dan kontras -->
          <p class="font-display text-4xl sm:text-[40px] leading-none mb-2 transition-colors duration-300 group-hover:text-accent"
             style="color: var(--text-decor);"
             aria-hidden="true">
            {year}
          </p>
          <div class="w-2 h-2 rounded-full mb-3 transition-colors duration-300 group-hover:bg-accent"
               style="background: var(--border);"
               aria-hidden="true"></div>

          <!-- Tahun untuk screen reader (tersembunyi secara visual) -->
          <h3 class="text-base font-semibold leading-snug mb-2" style="color: var(--text-primary);">
            <span class="sr-only">{year}: </span>{title}
          </h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-hint);">{desc}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- FASILITAS -->
  <section class="px-4 sm:px-8 py-12 sm:py-14"
           style="background: var(--bg-surface);"
           aria-labelledby="facility-title">

    <div class="flex items-baseline gap-5 mb-2">
      <h2 id="facility-title"
          class="font-display tracking-[2px] whitespace-nowrap section-headline"
          style="color: var(--text-primary);">
        FASILITAS KAMI
      </h2>
      <div class="flex-1 h-px hidden sm:block" style="background: var(--border);" aria-hidden="true"></div>
    </div>

    <p class="text-sm mt-2 mb-8" style="color: var(--text-hint);">
      Semua fasilitas tersedia untuk kenyamanan pengunjung.
    </p>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px list-none grid-facilities-4"
        style="background: var(--bg-gap);"
        id="fasilitas"
        aria-label="Daftar fasilitas Wisata Desa BMJ">

      {FACILITIES.map(({ name, note, icon }) => (
        <li class="flex items-start gap-4 px-5 py-6 transition-colors duration-200"
            style="background: var(--bg-surface);"
            onmouseover="this.style.background='var(--bg-hover)'"
            onmouseout="this.style.background='var(--bg-surface)'">

          <!-- Ikon fasilitas dengan deskripsi tersembunyi untuk screen reader -->
          <i class={`ti ti-${icon} text-2xl text-accent shrink-0 mt-0.5`}
             aria-hidden="true"></i>

          <div>
            <p class="text-base font-semibold leading-snug mb-1" style="color: var(--text-primary);">{name}</p>
            <p class="text-sm leading-relaxed" style="color: var(--text-hint);">{note}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <!-- SOSIAL MEDIA -->
  <section class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 flex-wrap px-4 sm:px-8 py-12 sm:py-14 border-t"
           style="border-color: var(--border);"
           aria-labelledby="social-title">

    <div>
      <h2 id="social-title"
          class="font-display tracking-[2px] mb-2"
          style="color: var(--text-primary); font-size: clamp(1.75rem, 4vw, 2.25rem);">
        IKUTI KAMI
      </h2>
      <p class="text-sm" style="color: var(--text-hint);">
        Lihat aktivitas dan foto terbaru kami di media sosial
      </p>
    </div>

    <div class="flex flex-wrap gap-3" role="list" aria-label="Tautan media sosial">
      {SOCIALS.map(({ label, icon, url }) => (
        <a href={url}
           target="_blank"
           rel="noopener noreferrer"
           aria-label={`Ikuti kami di ${label} (membuka tab baru)`}
           class="flex items-center gap-2 px-5 py-3 border text-sm tracking-[2px] uppercase transition-all duration-200 hover:border-accent hover:text-accent min-h-[48px] rounded-sm"
           style="border-color: var(--border); color: var(--text-hint);"
           role="listitem">
          <i class={`ti ti-${icon}`} aria-hidden="true"></i>
          {label}
        </a>
      ))}
    </div>
  </section>

</BaseLayout>
