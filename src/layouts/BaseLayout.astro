---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { SITE } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const {
  title,
  description = SITE.description,
  ogImage = `${SITE.url}/images/og-default.jpg`,
  canonicalUrl = Astro.url.href,
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="wisata desa, wisata desa bmj, wisata mojopahit, wisata majapahit, wisata jawa timur, patung gajah mada muri" />
    <meta name="author" content={SITE.fullName} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content="id_ID" />
    <meta property="og:site_name"   content={SITE.name} />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <meta name="geo.region"    content="ID-JI" />
    <meta name="geo.placename" content="Mojokerto, Jawa Timur" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body>
    <!-- SKIP NAVIGATION — sangat penting untuk screen reader dan keyboard users -->
    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>
    <a href="#main-nav" class="skip-link">Langsung ke navigasi</a>

    <!-- WARNING MODAL -->
    <div id="warning-modal"
         class="fixed inset-0 z-9999 hidden items-center justify-center p-4 sm:p-6"
         style="background: rgba(0,0,0,0.82);"
         role="dialog"
         aria-modal="true"
         aria-labelledby="warning-title"
         aria-describedby="warning-desc">

      <div class="w-full max-w-lg border-t-[3px] border-t-accent p-6 sm:p-9 border border-(--border)"
           style="background: var(--bg-surface);">

        <i class="ti ti-alert-triangle text-3xl text-accent mb-4 block" aria-hidden="true"></i>

        <h2 id="warning-title"
            class="font-display text-2xl sm:text-3xl tracking-widest mb-4"
            style="color: var(--text-primary);">
          PERHATIAN PENGUNJUNG WEBSITE
        </h2>

        <div id="warning-desc">
          <p class="text-base leading-relaxed mb-3" style="color: var(--text-muted);">
            Website ini dibuat tanpa izin resmi dari pemilik <strong>Wisata Desa BMJ</strong>.
            Website ini dibangun semata-mata untuk menyelesaikan tugas sekolah dan bukan untuk
            penggunaan komersial.
          </p>
          <p class="text-base leading-relaxed" style="color: var(--text-muted);">
            Jika anda memiliki pesan/saran/kritik bisa kirim via email.
            <a class="font-extrabold underline" href="mailto:jiichiro@proton.me">jiichiro@proton.me</a>
          </p>
        </div>

        <button id="warning-close"
                class="inline-flex items-center gap-2 bg-accent hover:bg-accent-hover text-white text-sm font-medium tracking-widest uppercase px-6 py-3 mt-6 transition-colors duration-200 cursor-pointer min-h-[48px]"
                aria-label="Tutup peringatan dan lanjutkan ke website">
          <i class="ti ti-check" aria-hidden="true"></i>
          Saya Mengerti
        </button>

        <p class="mt-4 text-sm" style="color: var(--text-hint);">
          Pesan ini hanya muncul sekali setiap kunjungan.
        </p>
      </div>
    </div>

    <Navbar />

    <!-- ID main-content untuk skip link -->
    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Theme & warning init — is:inline agar tidak flash -->
    <script is:inline>
      const saved = localStorage.getItem('bmj-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.setAttribute('data-theme', saved ?? (prefersDark ? 'dark' : 'light'));

      function initWarning() {
        if (sessionStorage.getItem('bmj-warning-shown')) return;
        const modal    = document.getElementById('warning-modal');
        const closeBtn = document.getElementById('warning-close');
        if (!modal || !closeBtn) return;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        closeBtn.focus();
        closeBtn.addEventListener('click', () => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          sessionStorage.setItem('bmj-warning-shown', '1');
          // Kembalikan fokus ke konten utama setelah modal ditutup
          const main = document.getElementById('main-content');
          if (main) main.focus();
        }, { once: true });
        // Keyboard: tekan Escape untuk tutup
        modal.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeBtn.click();
        });
      }
      document.addEventListener('DOMContentLoaded', initWarning);
    </script>
  </body>
</html>
